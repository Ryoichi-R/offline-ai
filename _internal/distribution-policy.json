{
  "schema_version": "1.0",
  "entries": [
    { "pattern": "README.md", "distribution": "both", "reason": "利用者向け導入手順", "boundary_row": "public-source-artifact" },
    { "pattern": "CHANGELOG.md", "distribution": "both", "reason": "版毎の変更履歴", "boundary_row": "public-source-artifact" },
    { "pattern": "SUPPORT.md", "distribution": "both", "reason": "問い合わせ窓口案内", "boundary_row": "public-source-artifact" },
    { "pattern": "THIRD-PARTY-NOTICES.md", "distribution": "both", "reason": "第三者componentの台帳", "boundary_row": "public-source-artifact" },
    { "pattern": "UNINSTALL.md", "distribution": "both", "reason": "削除手順", "boundary_row": "public-source-artifact" },
    { "pattern": "VERSION", "distribution": "both", "reason": "製品version", "boundary_row": "public-source-artifact" },
    { "pattern": "offline-ai-setup-guide.md", "distribution": "both", "reason": "利用者向けセットアップガイド", "boundary_row": "public-source-artifact" },
    { "pattern": "release-metadata.json", "distribution": "both", "reason": "公開承認metadata。既存挙動を維持", "boundary_row": "public-source-artifact" },
    { "pattern": "release/preparation-policy.json", "distribution": "public-source", "reason": "release candidateの品質・実機受入gate", "boundary_row": "public-source-artifact" },
    { "pattern": "legal/README.md", "distribution": "both", "reason": "model license可視化policy", "boundary_row": "public-source-artifact" },

    { "pattern": "LICENSE", "distribution": "both", "reason": "owner指定のMIT license（Ryoichi-Rice and contributors）。sourceと搬送packageに同梱", "boundary_row": "public-source-artifact" },

    { "pattern": "search.bat", "distribution": "both", "reason": "正式entrypoint（コンソール検索）", "boundary_row": "runtime-app-payload" },
    { "pattern": "index.bat", "distribution": "both", "reason": "Embedding事前構築entrypoint", "boundary_row": "runtime-app-payload" },
    { "pattern": "web.bat", "distribution": "both", "reason": "正式entrypoint（loopback Web検索）", "boundary_row": "runtime-app-payload" },
    { "pattern": "install-offline.bat", "distribution": "both", "reason": "install launcher。再インストール・修復時に再実行され得る", "boundary_row": "runtime-app-payload" },
    { "pattern": "download-package.bat", "distribution": "public-source", "reason": "developer/publisher向けpackage構築launcher。完全offline runtimeでは実行対象外", "boundary_row": "public-source-artifact" },

    { "pattern": "_internal/deep_candidate_selection.py", "distribution": "both", "reason": "deep候補転送契約・選別runtime実装", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/*.py", "distribution": "both", "reason": "検索・回答生成runtime実装", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/ARCHITECTURE.md", "distribution": "public-source", "reason": "開発者向け内部設計文書。利用者向けruntimeには不要", "boundary_row": "public-source-artifact" },
    { "pattern": "_internal/OfflineAi.Common.psm1", "distribution": "both", "reason": "package/installer共有helper", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/OfflineAi.ModelSelection.psm1", "distribution": "both", "reason": "対象PC入力の正規化、catalog検証、chatモデル推薦・選択の共有helper", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/OllamaRegistryDownloader.psm1", "distribution": "both", "reason": "download-only経路のmodel取得helper。既存挙動を維持", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/build-offline-package.ps1", "distribution": "both", "reason": "user-built package生成script。既存挙動を維持", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/download-offline-package.ps1", "distribution": "both", "reason": "download-only package生成script。既存挙動を維持", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/install-offline.ps1", "distribution": "both", "reason": "install実装本体", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/download-manifest.json", "distribution": "both", "reason": "installer/model取得manifest", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/.model.example", "distribution": "both", "reason": "モデル設定fileの記述例。既存挙動を維持", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/scripts/collect_skill_source.ps1", "distribution": "both", "reason": "search.pyがsubprocessとして呼び出すruntime実装", "boundary_row": "runtime-app-payload" },
    { "pattern": "_internal/web/index.html", "distribution": "both", "reason": "loopback Web UI", "boundary_row": "runtime-app-payload" },

    { "pattern": "infographic/**", "distribution": "excluded", "reason": "紹介資料。既存test（-PublicRelease出力にinfographicを含めない）の挙動を維持し、public source/runtime双方で除外する", "boundary_row": "generated-excluded" },

    { "pattern": "CONTRIBUTING.md", "distribution": "public-source", "reason": "開発者向け貢献ガイド", "boundary_row": "public-source-artifact" },
    { "pattern": "SECURITY.md", "distribution": "public-source", "reason": "脆弱性報告policy", "boundary_row": "public-source-artifact" },
    { "pattern": "CODE_OF_CONDUCT.md", "distribution": "public-source", "reason": "行動規範", "boundary_row": "public-source-artifact" },
    { "pattern": ".gitattributes", "distribution": "public-source", "reason": "検証済みsourceの改行byteをcheckout間で保持する", "boundary_row": "public-source-artifact" },
    { "pattern": ".gitignore", "distribution": "public-source", "reason": "開発時の補助防御契約", "boundary_row": "public-source-artifact" },
    { "pattern": ".git/**", "distribution": "excluded", "reason": "独立repositoryのGit管理情報", "boundary_row": "generated-excluded" },
    { "pattern": ".git", "distribution": "excluded", "reason": "worktreeのGit参照file", "boundary_row": "generated-excluded" },
    { "pattern": ".test-results/**", "distribution": "excluded", "reason": "独立repository内の検証出力", "boundary_row": "generated-excluded" },
    { "pattern": "pyproject.toml", "distribution": "public-source", "reason": "test/dev toolchain設定", "boundary_row": "public-source-artifact" },

    { "pattern": "scripts/**", "distribution": "public-source", "reason": "standalone開発bootstrap", "boundary_row": "public-source-artifact" },
    { "pattern": "tests/**", "distribution": "public-source", "reason": "test一式", "boundary_row": "public-source-artifact" },
    { "pattern": ".github/**", "distribution": "public-source", "reason": "CI定義・issue/PRテンプレート", "boundary_row": "public-source-artifact" },

    { "pattern": "_internal/distribution-policy.json", "distribution": "public-source", "reason": "本policy自体", "boundary_row": "public-source-artifact" },
    { "pattern": "_internal/schemas/**", "distribution": "public-source", "reason": "policy schema", "boundary_row": "public-source-artifact" },
    { "pattern": "_internal/scripts/Test-DistributionPolicy.ps1", "distribution": "public-source", "reason": "配布policy検証script（開発時のみ使用。runtimeでは呼ばれない）", "boundary_row": "public-source-artifact" },

    { "pattern": "legal/models/**", "distribution": "runtime", "reason": "package build時に生成されるmodel license可視化物。source repositoryには存在しない", "boundary_row": "user-built-transport" },

    { "pattern": "skill-source/**", "distribution": "excluded", "reason": "利用者資料。非追跡・非配布", "boundary_row": "generated-excluded" },
    { "pattern": "offline-package/**", "distribution": "excluded", "reason": "package build出力。生成物", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_cache.json", "distribution": "excluded", "reason": "実行時生成cache", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_cache.json.tmp", "distribution": "excluded", "reason": "実行時cacheのatomic保存中間file", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_cache.json.tmp.*", "distribution": "excluded", "reason": "実行時cacheのwriter別atomic保存中間file", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_cache.checkpoints/**", "distribution": "excluded", "reason": "Embedding再開用checkpoint。利用者資料を含み得る実行時生成物", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_cache.lock", "distribution": "excluded", "reason": "Embedding writer lock", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_index_status.json", "distribution": "excluded", "reason": "実行時index job status。利用者環境固有", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_index_status.json.tmp", "distribution": "excluded", "reason": "旧版statusのatomic保存中間file。復旧時の残骸を配布対象外にする", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_index_status.json.tmp.*", "distribution": "excluded", "reason": "実行時statusのwriter別atomic保存中間file", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/embed_index_status.json.lock", "distribution": "excluded", "reason": "実行時statusのprocess間lock", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/.model", "distribution": "excluded", "reason": "利用者環境固有のmodel選択（実体）", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/.model_embed", "distribution": "excluded", "reason": "利用者環境固有のembeddingモデル選択（実体）", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/.pdftotext", "distribution": "excluded", "reason": "撤去済みcomponentの残骸に対する防御的除外", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/install-state.json", "distribution": "excluded", "reason": "install先固有の状態file", "boundary_row": "generated-excluded" },
    { "pattern": "_internal/optional-components/**", "distribution": "excluded", "reason": "任意componentのuser-local staging", "boundary_row": "generated-excluded" },
    { "pattern": "**/__pycache__/**", "distribution": "excluded", "reason": "Python生成物", "boundary_row": "generated-excluded" },
    { "pattern": "**/*.pyc", "distribution": "excluded", "reason": "Python生成物", "boundary_row": "generated-excluded" },
    { "pattern": "**/*.pyo", "distribution": "excluded", "reason": "Python生成物", "boundary_row": "generated-excluded" },
    { "pattern": ".pytest_cache/**", "distribution": "excluded", "reason": "pytest生成cache", "boundary_row": "generated-excluded" },
    { "pattern": ".ruff_cache/**", "distribution": "excluded", "reason": "formatter and lint cache; machine-local generated output", "boundary_row": "generated-excluded" },
    { "pattern": "**/Thumbs.db", "distribution": "excluded", "reason": "OS生成物", "boundary_row": "generated-excluded" },
    { "pattern": "**/desktop.ini", "distribution": "excluded", "reason": "OS生成物", "boundary_row": "generated-excluded" },
    { "pattern": "**/.DS_Store", "distribution": "excluded", "reason": "OS生成物", "boundary_row": "generated-excluded" }
  ]
}

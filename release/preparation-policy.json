{
    "schema_version": "3.0",
    "public_root": ".",
    "profiles": ["source-repository"],
    "documents": [
        {
            "path": "README.md",
            "required_sections": [
                "配布状態",
                "動作要件",
                "インストール",
                "プライバシー",
                "ライセンス",
                "アンインストール"
            ]
        },
        {
            "path": "LICENSE",
            "required_sections": []
        }
    ],
    "candidate": {
        "allowlist": [
            "README.md",
            "CHANGELOG.md",
            "SUPPORT.md",
            "THIRD-PARTY-NOTICES.md",
            "UNINSTALL.md",
            "VERSION",
            "offline-ai-setup-guide.md",
            "release-metadata.json",
            "release/preparation-policy.json",
            "legal/README.md",
            "LICENSE",
            "search.bat",
            "index.bat",
            "web.bat",
            "install-offline.bat",
            "download-package.bat",
            "_internal/*.py",
            "_internal/ARCHITECTURE.md",
            "_internal/OfflineAi.Common.psm1",
            "_internal/OfflineAi.ModelSelection.psm1",
            "_internal/OllamaRegistryDownloader.psm1",
            "_internal/build-offline-package.ps1",
            "_internal/download-offline-package.ps1",
            "_internal/install-offline.ps1",
            "_internal/download-manifest.json",
            "_internal/.model.example",
            "_internal/scripts/collect_skill_source.ps1",
            "_internal/web/index.html",
            "_internal/distribution-policy.json",
            "_internal/schemas/**",
            "_internal/scripts/Test-DistributionPolicy.ps1",
            "CONTRIBUTING.md",
            "SECURITY.md",
            "CODE_OF_CONDUCT.md",
            ".gitattributes",
            ".gitignore",
            "pyproject.toml",
            "scripts/**",
            "tests/**",
            ".github/**"
        ],
        "denylist": [
            "infographic/**",
            "skill-source/**",
            "offline-package/**",
            "legal/models/**",
            "_internal/embed_cache.json",
            "_internal/embed_index_status.json",
            "_internal/.model",
            "_internal/.model_embed",
            "_internal/.pdftotext",
            "_internal/install-state.json",
            "_internal/optional-components/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.pyo",
            ".pytest_cache/**",
            "**/Thumbs.db",
            "**/desktop.ini",
            "**/.DS_Store",
            "**/*.log",
            "**/*.tmp"
        ],
        "max_file_bytes": 2097152,
        "max_total_bytes": 20971520,
        "allow_reparse_points": false
    },
    "validation": {
        "required_receipt_types": [
            "quality",
            "manual-acceptance",
            "clean-verification"
        ],
        "expected_test_projects": ["offline-ai-pytest", "offline-ai-pester"],
        "minimum_test_count": 223,
        "allow_skips": true,
        "minimum_line_coverage": 90,
        "minimum_branch_coverage": null,
        "require_formatter": true,
        "require_linter": true,
        "require_dependency_review": true,
        "build_requirement": "not-applicable",
        "build_not_applicable_reason": "公開物はソース ZIP。実行ファイル、インストーラー、モデルのビルドや同梱は行わず、ZIP の展開と内容の照合を必須とする。"
    },
    "manual_acceptance": [
        {
            "id": "windows-source-entrypoint-smoke",
            "requirement": "required",
            "reason": "Windows 11 x64 のクリーンな環境で ZIP を空白とアポストロフィを含むパスへ展開し、開発依存を手順どおり整備する。合成資料と fixture を使い、索引・CLI 検索・Web の起動、ヘルス確認、検索・中止・終了を確認する。"
        },
        {
            "id": "source-archive-content-review",
            "requirement": "required",
            "reason": "VERSION・release-metadata.json・公開予定のタグを照合。クリーン展開時に候補のファイル一覧・ハッシュ・余剰ファイルがないことを確認し、ZIP と SHA256SUMS.txt を確定する。"
        },
        {
            "id": "source-license-notice-review",
            "requirement": "required",
            "reason": "公開ソースの LICENSE ハッシュ、README の配布範囲、THIRD-PARTY-NOTICES.md を照合し、Python・Ollama・モデル・インストーラー・利用者資料を含まないことを確認する。"
        }
    ],
    "artifacts": [],
    "integrity": {
        "require_hashes": true,
        "require_sbom": false,
        "require_dependency_review": true,
        "require_clean_install": false
    }
}
